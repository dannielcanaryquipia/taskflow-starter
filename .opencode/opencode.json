{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "mcp": {},
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "todowrite": "allow",
    "task": "allow",
    "skill": "allow",
    "lsp": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git checkout *": "allow",
      "git switch *": "allow",
      "git branch*": "allow",
      "npm *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",
      "bun *": "allow",
      "node *": "allow",
      "npx *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "pip *": "allow",
      "pytest *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "rm": "deny",
      "rm *": "deny",
      "sudo *": "deny",
      "git push": "deny",
      "git push *": "deny",
      "git reset --hard*": "deny",
      "git clean *": "deny"
    }
  }
}
